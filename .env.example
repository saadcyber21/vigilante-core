# Generate each secret locally; for example: openssl rand -hex 32
APP_NAME=Vigilante Core
ENVIRONMENT=production
TENANT_ID=default
PORT=8000

POSTGRES_DB=vigilante
POSTGRES_USER=vigilante
POSTGRES_PASSWORD=replace-with-a-unique-random-value

JWT_SECRET=replace-with-at-least-64-random-hex-characters
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-16-or-more-characters

# Shared fallback for simple setups. In production, prefer unique source secrets below.
WEBHOOK_SECRET=replace-with-at-least-64-random-hex-characters
# Optional JSON map. When set, only listed source keys are accepted and each uses its own secret.
# Example: WEBHOOK_SOURCE_SECRETS={"edr":"<64-random-hex>","identity":"<64-random-hex>"}
MAX_PAYLOAD_BYTES=1048576
CORS_ORIGINS=https://vigilante-core.github.io

# Deterministic local rules are enabled; no LLM provider is required.
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
