APP_NAME=vigilante-core
ENVIRONMENT=development
DATABASE_URL=sqlite:///./vigilante.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://vigilante:change-me@localhost:5432/vigilante

JWT_SECRET=replace-with-a-long-random-development-secret
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
WEBHOOK_SECRET=replace-with-a-source-specific-secret
MAX_PAYLOAD_BYTES=1048576
CORS_ORIGINS=http://localhost:5173
LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
